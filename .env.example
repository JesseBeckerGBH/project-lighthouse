# Project Lighthouse demo configuration
# Copy this file to .env locally, then add real values there.
# Never commit .env or paste its contents into chat.

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://your-tunnel.example

# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# Demo business facts (safe, non-secret values only)
BUSINESS_NAME=JB Receptionist Demo
BUSINESS_TIMEZONE=America/Phoenix
BUSINESS_HOURS=Monday-Friday 8:00 AM-5:00 PM
BUSINESS_SERVICE_AREA=Chandler, Arizona
BUSINESS_SERVICES=Water heater repair, drain cleaning, leak detection

# Demo-only behavior
SCHEDULER_MODE=fake
NOTIFICATION_MODE=console
LOG_LEVEL=info
